# ================================
# SERVER
# ================================
PORT=5000
NODE_ENV=development

# ================================
# DATABASE
# ================================
# Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/ai_exam_system
#
# MongoDB Atlas (use this for production):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai_exam_system
MONGODB_URI=your_mongodb_connection_string_here

# ================================
# JWT AUTHENTICATION
# ================================
# Generate strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ================================
# EMAIL (for password reset / notifications)
# ================================
# Use Gmail App Password — NOT your real Gmail password
# Setup: myaccount.google.com → Security → 2FA → App Passwords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password

# ================================
# FRONTEND URL (used in CORS)
# ================================
# Local:       http://localhost:5173
# Production:  https://your-app.vercel.app
CLIENT_URL=http://localhost:5173